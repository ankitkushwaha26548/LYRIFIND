{
  "name": "lyrifind",
  "version": "1.0.0",
  "description": "LyriFind - Lyrics Discovery & Management Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --coverage"
  },
  "keywords": ["lyrics", "express", "jwt", "crud"],
  "author": "Ankit Kushwaha",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "optionalDependencies": {
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/store/mongoStore.js"]
  }
