# Copy to .env and edit
PORT=5000
NODE_ENV=development
# Local MongoDB, or paste a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/lyrifind
JWT_SECRET=AKAKAKAK
JWT_EXPIRES_IN=2h
# Registering with this e-mail creates an ADMIN account
ADMIN_EMAIL=admin@lyrifind.local
# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Insert sample songs + demo admin when the database is empty
SEED_ON_START=true
